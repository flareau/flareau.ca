RewriteEngine on
Options All -Indexes
AddType 'text/html; charset=UTF-8' html
ErrorDocument 404 /index.php

# Change base folder

RewriteCond %{HTTP_HOST} ^(www.)?flareau.ca$
RewriteCond %{REQUEST_URI} !^/flareau.ca/
RewriteCond %{REQUEST_FILENAME} !-f 
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /flareau.ca/$1
RewriteCond %{HTTP_HOST} ^(www.)?flareau.ca$ 
RewriteRule ^(/)?$ flareau.ca/index.php [L]

#RewriteRule .*\.(jpg|jpeg|gif|png|bmp)$ - [F,NC]
